  {
    "description": "all six variables substitute; screenshot present so the #if block renders",
    "input": {
      "template": "Captured {{captured_at_iso}} for {{project_name}} ({{workspace_name}}).\n\nTranscript: {{transcript}}\nNotes: {{notes}}\n{{#if screenshot_url}}Screenshot: {{screenshot_url}}{{/if}}",
      "vars": {
        "transcript": "add a dark mode toggle",
        "notes": "top right of settings",
        "screenshot_url": "https://example.convex.cloud/api/storage/abc123",
        "captured_at_iso": "2026-07-04T18:30:00.000Z",
        "project_name": "Whistle",
        "workspace_name": "idea: add a dark mode toggle #a1b2c3"
      }
    },
    "expected": "Captured 2026-07-04T18:30:00.000Z for Whistle (idea: add a dark mode toggle #a1b2c3).\n\nTranscript: add a dark mode toggle\nNotes: top right of settings\nScreenshot: https://example.convex.cloud/api/storage/abc123"
  },
  {
